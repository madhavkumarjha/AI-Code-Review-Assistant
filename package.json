{
  "name": "ai-code-review-assistant",
  "version": "2.0.0",
  "private": true,
  "description": "Autonomous Instant Code Intelligence Platform",
  "main": "start.js",
  "scripts": {
    "dev": "node start.js dev",
    "start": "node start.js",
    "build": "npm run build --prefix client",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "test": "node -e \"console.log('Testing client build...')\" && npm run build --prefix client"
  },
  "keywords": [
    "code-review",
    "ai-intelligence",
    "developer-tools",
    "monaco-editor",
    "diff-viewer"
  ],
