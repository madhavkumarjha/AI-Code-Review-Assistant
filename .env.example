# AI Code Review Assistant Environment Variables Configuration

# Server Port
PORT=5000

# Groq API Key (Get your key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Primary Groq Model ID (Backups: openai/gpt-oss-20b, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# Allowed Origin for CORS (Production)
ALLOWED_ORIGIN=https://ai-code-review-assistant-sand.vercel.app

# Trust Proxy Setting for Reverse Proxies (Render / Vercel / Nginx)
TRUST_PROXY=1
