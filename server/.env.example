# Express Server Port
PORT=5000

# Groq API Key (Get your free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Primary Groq Model ID (Backups: openai/gpt-oss-20b, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# CORS Allowed Origin for production deployment
ALLOWED_ORIGIN=https://ai-code-review-assistant-sand.vercel.app

# Trust Proxy configuration (1 for single reverse proxy like Render/Vercel/Nginx)
TRUST_PROXY=1
