# Express Server Port
PORT=5000

# Groq API Key (Get your free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Configurable CORS allowed origin for production (Optional)
# ALLOWED_ORIGIN=https://your-frontend.vercel.app

# Trust Proxy configuration (1 for single reverse proxy like Render/Vercel/Nginx)
TRUST_PROXY=1
